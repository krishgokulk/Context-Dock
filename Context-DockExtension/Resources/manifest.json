{
  "manifest_version": 3,
  "name": "Context Dock",
  "version": "1.1",
  "description": "Sends rich browser context (page text, selected text, scroll position) to Context Dock.",

  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },

  "action": {
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png",
      "128": "icon-128.png"
    },
    "default_title": "Context Dock"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "nativeMessaging",
    "activeTab",
    "tabs",
    "scripting"
  ],

  "host_permissions": ["http://*/*", "https://*/*"],

  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
