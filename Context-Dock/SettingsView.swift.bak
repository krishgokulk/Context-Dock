// MARK: - Launch at Login Toggle
struct LaunchAtLoginToggle: View {
    @StateObject private var launchHelper = LaunchAtLoginHelper.shared

    var body: some View {
        if #available(macOS 13.0, *) {
            HStack(alignment: .center) {
                Image(systemName: "arrow.triangle.2.circlepath")
                    .foregroundStyle(.blue)
                VStack(alignment: .leading, spacing: 4) {
                    Text("Launch at Login")
                        .font(.headline)
                    Text("Start ILauncher automatically when you log in")
                        .font(.caption)
                        .foregroundStyle(.secondary)
                }
                Spacer()
                Toggle("", isOn: Binding(
                    get: { launchHelper.isEnabled },
                    set: { launchHelper.setEnabled($0) }
                ))
                .toggleStyle(.switch)
            }
        } else {
            HStack(alignment: .center) {
                Image(systemName: "arrow.triangle.2.circlepath")
                    .foregroundStyle(.secondary)
                VStack(alignment: .leading, spacing: 4) {
                    Text("Launch at Login")
                        .font(.headline)
                    Text("Requires macOS 13 or later")
                        .font(.caption)
                        .foregroundStyle(.secondary)
                }
                Spacer()
                Toggle("", isOn: .constant(false))
                    .toggleStyle(.switch)
                    .disabled(true)
                    .opacity(0.5)
            }
        }
    }
}

// MARK: - AI Extensions Settings Tab
struct AIExtensionsSettingsView: View {
    @ObservedObject var settings = AppSettings.shared
    @State private var showReloadConfirmation = false

    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 20) {
                // Header
                VStack(alignment: .leading, spacing: 8) {
                    HStack {
                        VStack(alignment: .leading, spacing: 4) {
                            Text("AI Extensions")
                                .font(.title2)
                                .fontWeight(.semibold)
                            Text("Hammerspoon automation - Import .lua and .spoon scripts")
                                .font(.subheadline)
                                .foregroundStyle(.secondary)
                        }

                        Spacer()

                        // Reload Button
                        Button(action: {
                            ExtensionRegistry.shared.loadCapabilities()
                            showReloadConfirmation = true

                            DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
                                showReloadConfirmation = false
                            }
                        }) {
                            HStack(spacing: 6) {
                                if showReloadConfirmation {
                                    Image(systemName: "checkmark.circle.fill")
                                        .foregroundStyle(.green)
                                    Text("Reloaded!")
                                } else {
                                    Label("Reload", systemImage: "arrow.clockwise")
                                }
                            }
                        }
                        .buttonStyle(.borderedProminent)
                        .animation(.easeInOut(duration: 0.2), value: showReloadConfirmation)
                    }
                }

                Divider()

                // Info Section
                CardSection(title: "How AI Extensions Work", systemImage: "info.circle") {
                    VStack(alignment: .leading, spacing: 12) {
                        Text("AI Extensions respond to natural language commands when you're in **AI mode**.")
                            .font(.body)

                        VStack(alignment: .leading, spacing: 8) {
                            HStack(alignment: .top, spacing: 8) {
                                Text("1.")
                                    .fontWeight(.bold)
                                VStack(alignment: .leading, spacing: 4) {
                                    Text("Switch to AI mode")
                                        .fontWeight(.medium)
                                    Text("Click your AI provider icon (Ollama/On-Device/Shortcuts)")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                            }

                            HStack(alignment: .top, spacing: 8) {
                                Text("2.")
                                    .fontWeight(.bold)
                                VStack(alignment: .leading, spacing: 4) {
                                    Text("Type natural language")
                                        .fontWeight(.medium)
                                    Text("Example: \"calculate 5 + 3\", \"search for Swift tutorials\"")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                            }

                            HStack(alignment: .top, spacing: 8) {
                                Text("3.")
                                    .fontWeight(.bold)
                                VStack(alignment: .leading, spacing: 4) {
                                    Text("AI routes to extension")
                                        .fontWeight(.medium)
                                    Text("The AI determines which extension can help and executes it")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                            }
                        }
                    }
                }

                // Built-in Extensions List
                CardSection(title: "Built-in Extensions", systemImage: "sparkles") {
                    VStack(alignment: .leading, spacing: 16) {
                        ExtensionInfoRow(
                            icon: "magnifyingglass",
                            name: "Web Search",
                            description: "Search the web for information",
                            examples: ["search for Swift tutorials", "look up quantum physics"]
                        )

                        Divider()

                        ExtensionInfoRow(
                            icon: "function",
                            name: "Calculator",
                            description: "Perform mathematical calculations",
                            examples: ["calculate 15% of 200", "what is sqrt(144)"]
                        )

                        Divider()

                        ExtensionInfoRow(
                            icon: "desktopcomputer",
                            name: "System Info",
                            description: "Get system information about your Mac",
                            examples: ["show system info", "how much disk space"]
                        )

                        Divider()

                        ExtensionInfoRow(
                            icon: "doc.text.magnifyingglass",
                            name: "File Finder",
                            description: "Find files on your Mac",
                            examples: ["find file named report.pdf", "locate recent downloads"]
                        )
                    }
                }

                // Hammerspoon AI Mode
                CardSection(title: "Hammerspoon AI Mode", systemImage: "hammer.circle.fill") {
                    VStack(alignment: .leading, spacing: 12) {
                        Toggle(isOn: $settings.enableHammerspoonAIMode) {
                            VStack(alignment: .leading, spacing: 4) {
                                Text("Enable Hammerspoon Lua Script Generation")
                                    .font(.headline)
                                Text("AI generates and executes Lua scripts directly in Hammerspoon")
                                    .font(.caption)
                                    .foregroundStyle(.secondary)
                            }
                        }
                        .toggleStyle(.switch)

                        if settings.enableHammerspoonAIMode {
                            VStack(alignment: .leading, spacing: 8) {
                                HStack(spacing: 6) {
                                    Image(systemName: "checkmark.circle.fill")
                                        .foregroundStyle(.green)
                                        .font(.caption)
                                    Text("Everything you type → AI generates Lua → Hammerspoon executes")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                                HStack(spacing: 6) {
                                    Image(systemName: "info.circle.fill")
                                        .foregroundStyle(.blue)
                                        .font(.caption)
                                    Text("Hammerspoon must be installed and running")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                                HStack(spacing: 6) {
                                    Image(systemName: "exclamationmark.triangle.fill")
                                        .foregroundStyle(.orange)
                                        .font(.caption)
                                    Text("When enabled, AI Extension Routing is bypassed - pure Lua generation")
                                        .font(.caption)
                                        .foregroundStyle(.orange)
                                }

                                Divider()

                                VStack(alignment: .leading, spacing: 6) {
                                    Text("Examples:")
                                        .font(.caption)
                                        .fontWeight(.semibold)
                                    Text("• \"maximize current window\"")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                    Text("• \"show battery percentage\"")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                    Text("• \"get current wifi name\"")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                    Text("• \"open safari and tile windows\"")
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }

                                Divider()

                                HStack(spacing: 6) {
                                    Image(systemName: "gear")
                                        .foregroundStyle(.secondary)
                                        .font(.caption)
                                    Text("Edit the system prompt in Settings → AI Provider → Hammerspoon AI System Prompt")
                                        .font(.caption2)
                                        .foregroundStyle(.secondary)
                                }
                            }
                            .padding()
                            .background(Color.green.opacity(0.06))
                            .cornerRadius(8)
                        }
                    }
                }

                // Capabilities Info
                CardSection(title: "Loaded Capabilities", systemImage: "checklist") {
                    let capabilityCount = ExtensionRegistry.shared.getAllCapabilities().count

                    if capabilityCount > 0 {
                        VStack(alignment: .leading, spacing: 8) {
                            Text("\(capabilityCount) capabilities loaded")
                                .font(.headline)

                            ForEach(ExtensionRegistry.shared.getAllCapabilities().prefix(10)) { capability in
                                HStack {
                                    Image(systemName: "checkmark.circle.fill")
                                        .foregroundStyle(.green)
                                        .font(.caption)
                                    Text(capability.name)
                                        .font(.body)
                                    Spacer()
                                    Text(capability.category)
                                        .font(.caption)
                                        .padding(.horizontal, 8)
                                        .padding(.vertical, 2)
                                        .background(Color.secondary.opacity(0.2))
                                        .cornerRadius(4)
                                }
                            }

                            if capabilityCount > 10 {
                                Text("+ \(capabilityCount - 10) more...")
                                    .font(.caption)
                                    .foregroundStyle(.secondary)
                            }
                        }
                    } else {
                        Text("No capabilities loaded. Click 'Reload' to load extensions.")
                            .foregroundStyle(.secondary)
                    }
                }

                Spacer()
            }
            .padding()
        }
    }
}

// Helper view for extension info
struct ExtensionInfoRow: View {
    let icon: String
    let name: String
    let description: String
    let examples: [String]

    var body: some View {
        VStack(alignment: .leading, spacing: 8) {
            HStack(spacing: 8) {
                Image(systemName: icon)
                    .font(.title3)
                    .foregroundStyle(.blue)
                Text(name)
                    .font(.headline)
            }

            Text(description)
                .font(.body)
                .foregroundStyle(.secondary)

            VStack(alignment: .leading, spacing: 4) {
                Text("Examples:")
                    .font(.caption)
                    .fontWeight(.semibold)
                    .foregroundStyle(.secondary)

                ForEach(examples, id: \.self) { example in
                    HStack(spacing: 4) {
                        Text("•")
                            .foregroundStyle(.secondary)
                        Text("\"\(example)\"")
                            .font(.caption)
                            .foregroundStyle(.secondary)
                            .italic()
                    }
                }
            }
        }
    }
}

// MARK: - Extensions Settings Tab
struct ExtensionsSettingsView: View {
    @ObservedObject var settings = AppSettings.shared
    @State private var isImporting = false
    @State private var showReloadConfirmation = false

    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 20) {
                // Header
                VStack(alignment: .leading, spacing: 8) {
                    HStack {
                        VStack(alignment: .leading, spacing: 4) {
                            Text("Extensions")
                                .font(.title2)
                                .fontWeight(.semibold)
                            Text("Manage status bar and script extensions")
                                .font(.subheadline)
                                .foregroundStyle(.secondary)
                        }

                        Spacer()

                        // Reload Button (prominent)
                        Button(action: {
                            ExtensionManager.shared.loadExtensions()
                            showReloadConfirmation = true

                            // Hide confirmation after 2 seconds
                            DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
                                showReloadConfirmation = false
                            }
                        }) {
                            HStack(spacing: 6) {
                                if showReloadConfirmation {
                                    Image(systemName: "checkmark.circle.fill")
                                        .foregroundStyle(.green)
                                    Text("Reloaded!")
                                } else {
                                    Label("Reload Extensions", systemImage: "arrow.clockwise")
                                }
                            }
                        }
                        .buttonStyle(.borderedProminent)
                        .help("Reload all extensions to see changes immediately")
                        .animation(.easeInOut(duration: 0.2), value: showReloadConfirmation)
                    }
                }

                Divider()

                // Status Bar Extensions Section
                CardSection(title: "Status Bar Extensions", systemImage: "menubar.rectangle") {
                    VStack(alignment: .leading, spacing: 12) {
                        Toggle(isOn: Binding(
                            get: { settings.enableStatusBar },
                            set: { newValue in
                                settings.enableStatusBar = newValue
                                // Reload extensions immediately on any change
                                ExtensionManager.shared.loadExtensions()
                            }
                        )) {
                            VStack(alignment: .leading, spacing: 4) {
                                Text("Enable Status Bar")
                                    .font(.headline)
                                Text("Show status bar extensions at the top of ILauncher")
                                    .font(.caption)
                                    .foregroundStyle(.secondary)
                            }
                        }
                        .toggleStyle(.switch)

                        Text("Status bar extensions display system information, media controls, and custom data at the top of the launcher window.")
                            .font(.caption)
                            .foregroundStyle(.secondary)
                            .padding(.top, 4)
                    }
                }

                Divider()

                // Script Extensions Import Section
                CardSection(title: "Script Extensions", systemImage: "doc.text.fill") {
                    VStack(alignment: .leading, spacing: 12) {
                        Text("Import custom scripts for Hammerspoon and automation")
                            .font(.caption)
                            .foregroundStyle(.secondary)

                    HStack(spacing: 12) {
                        Button(action: {
                            isImporting = true
                        }) {
                            Label("Import Scripts", systemImage: "square.and.arrow.down")
                        }
                        .buttonStyle(.borderedProminent)
                        .fileImporter(
                            isPresented: $isImporting,
                            allowedContentTypes: [.item],
                            allowsMultipleSelection: true
                        ) { result in
                            switch result {
                            case .success(let urls):
                                for url in urls {
                                    settings.addExtensionScript(url: url)
                                }
                            case .failure(let error):
                                print("⚠️ Failed to import: \(error)")
                            }
                        }

                        Text("Supported: .spoon, .lua, .sh, .jxa, .py")
                            .font(.caption)
                            .foregroundStyle(.secondary)
                    }

                    // Drag & Drop area
                    ZStack {
                        RoundedRectangle(cornerRadius: 12)
                            .stroke(style: StrokeStyle(lineWidth: 2, dash: [8]))
                            .foregroundStyle(.secondary.opacity(0.4))

                        VStack(spacing: 8) {
                            Image(systemName: "arrow.down.doc.fill")
                                .font(.system(size: 32))
                                .foregroundStyle(.secondary)
                            Text("Drag & Drop Scripts Here")
                                .font(.subheadline)
                                .foregroundStyle(.secondary)
                        }
                        .padding(.vertical, 30)
                    }
                    .frame(height: 120)
                    .onDrop(of: [.fileURL], isTargeted: nil) { providers in
                        for provider in providers {
                            _ = provider.loadObject(ofClass: URL.self) { url, _ in
                                if let url = url {
                                    DispatchQueue.main.async {
                                        settings.addExtensionScript(url: url)
                                    }
                                }
                            }
                        }
                        return true
                    }
                    }
                }

                Divider()

                // Installed Scripts List
                CardSection(title: "Installed Scripts", systemImage: "list.bullet.rectangle") {
                    VStack(alignment: .leading, spacing: 12) {
                        Text("\(settings.extensionScripts.count) script(s) installed")
                            .font(.caption)
                            .foregroundStyle(.secondary)

                    if settings.extensionScripts.isEmpty {
                        VStack(spacing: 12) {
                            Image(systemName: "tray.fill")
                                .font(.system(size: 40))
                                .foregroundStyle(.secondary)
                            Text("No extension scripts added yet")
                                .font(.subheadline)
                                .foregroundStyle(.secondary)
                            Text("Import scripts using the button above or drag & drop them")
                                .font(.caption)
                                .foregroundStyle(.tertiary)
                                .multilineTextAlignment(.center)
                        }
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, 40)
                    } else {
                        ForEach(settings.extensionScripts) { script in
                            ExtensionScriptRow(script: script)
                        }
                    }
                    }
                }
            }
            .padding()
        }
    }
}

// MARK: - Extension Script Row
struct ExtensionScriptRow: View {
    @ObservedObject var settings = AppSettings.shared
    let script: ExtensionScript

    var body: some View {
        HStack(spacing: 12) {
            // Icon
            Image(systemName: script.type.icon)
                .font(.title3)
                .foregroundStyle(script.isEnabled ? .blue : .secondary)
                .frame(width: 32)

            // Info
            VStack(alignment: .leading, spacing: 4) {
                Text(script.name)
                    .font(.subheadline)
                    .fontWeight(.medium)
                    .foregroundStyle(script.isEnabled ? .primary : .secondary)

                HStack(spacing: 6) {
                    Text(script.type.displayName)
                        .font(.caption)
                        .foregroundStyle(.secondary)
                    Text("•")
                        .foregroundStyle(.tertiary)
                    Text(script.path)
                        .font(.caption)
                        .foregroundStyle(.tertiary)
                        .lineLimit(1)
                        .truncationMode(.middle)
                }
            }

            Spacer()

            // Controls
            HStack(spacing: 8) {
                Toggle("", isOn: Binding(
                    get: { script.isEnabled },
                    set: { _ in settings.toggleExtensionScript(script) }
                ))
                .toggleStyle(.switch)
                .controlSize(.small)

                Button(action: {
                    settings.removeExtensionScript(script)
                }) {
                    Image(systemName: "trash")
                        .foregroundStyle(.red)
                }
                .buttonStyle(.borderless)
                .help("Remove script")
            }
        }
        .padding(12)
        .background(script.isEnabled ? Color.blue.opacity(0.08) : Color.gray.opacity(0.04))
        .cornerRadius(8)
    }
}

#Preview {
    SettingsView()
}

