                    .font(.system(size: 14, weight: .medium))
                    .lineLimit(1)
                
                HStack(spacing: 8) {
                    Text(item.size)
                        .font(.system(size: 11))
                        .foregroundStyle(.secondary)
                    
                    Text("•")
                        .font(.system(size: 11))
                        .foregroundStyle(.tertiary)
                    
                    Text(item.modifiedDate)
                        .font(.system(size: 11))
                        .foregroundStyle(.secondary)
                }
