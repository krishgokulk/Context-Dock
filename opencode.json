{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "skill": { "*": "allow" },
    "bash": {
      "*": "ask",
      "./scripts/dev-run.sh": "allow",
      "./scripts/build-debug.sh": "allow",
      "./scripts/check.sh": "allow",
      "./scripts/check.sh --full": "allow",
      "./scripts/test.sh": "allow",
      "graphify query *": "allow",
      "graphify path *": "allow",
      "graphify explain *": "allow",
      "graphify update .": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git fetch*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git branch --show-current": "allow",
      "git worktree list*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "./scripts/ship.sh*": "deny",
      "scripts/ship.sh*": "deny",
      "bash scripts/ship.sh*": "deny",
      "./scripts/release-prep.sh*": "deny",
      "scripts/release-prep.sh*": "deny",
      "git stash*": "deny",
      "git reset --hard*": "deny",
      "git reset * --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -d*": "deny",
      "git clean -x*": "deny",
      "git clean -fd*": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add .": "deny",
      "git commit -a*": "deny",
      "git commit --all*": "deny",
      "git commit -am*": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git restore *": "deny",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push * +main*": "deny",
      "git push * *:main*": "deny",
      "git push *refs/heads/main*": "deny",
      "git push origin main*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny",
      "rm -rf /": "deny"
    }
  }
}
