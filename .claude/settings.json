{
  "permissions": {
    "allow": [
      "Bash(./scripts/dev-run.sh)",
      "Bash(./scripts/build-debug.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(./scripts/check.sh --full)",
      "Bash(./scripts/test.sh)",
      "Bash(graphify query *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify update .)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)"
    ],
    "ask": [
      "Bash(./scripts/ship.sh)",
      "Bash(./scripts/ship.sh *)",
      "Bash(scripts/ship.sh*)",
      "Bash(bash scripts/ship.sh*)",
      "Bash(./scripts/release-prep.sh*)",
      "Bash(scripts/release-prep.sh*)"
    ],
    "deny": [
      "Bash(git stash*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git commit -am*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main*)",
      "Bash(git push * +main*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf /)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-guard.sh search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-guard.sh read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
